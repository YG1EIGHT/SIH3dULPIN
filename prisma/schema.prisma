generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(VIEWER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Building {
  id             String         @id @default(uuid())
  name           String
  latitude       Float
  longitude      Float
  approvalStatus ApprovalStatus @default(PENDING_REVIEW)
  surveyorId     String?
  verifiedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  floors         Floor[]

  @@index([approvalStatus])
}

model Floor {
  id          String     @id @default(uuid())
  buildingId  String
  floorNumber Int
  elevation   Float
  height      Float
  building    Building   @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  units       Property[]

  @@unique([buildingId, floorNumber])
}

model Property {
  id         String   @id @default(uuid())
  floorId    String
  unitNumber String
  ulpin      String?  @unique
  area       Float
  spaceType  String
  polygon    Json
  createdAt  DateTime @default(now())
  floor      Floor    @relation(fields: [floorId], references: [id], onDelete: Cascade)
}

enum ApprovalStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum UserRole {
  VIEWER
  SURVEYOR
}
